# Downloaded GGUF weights and exported image tarballs — large, regenerable.
/models/*
!/models/.gitkeep
/images/*
!/images/.gitkeep

# Generated clips/images saved by the chat (served from /api/media).
/media/*
!/media/.gitkeep

# Temp docker build contexts.
/.build/

# Built tool binary.
/local-llm
/local-llm.exe

# Note: config/models.json is committed (tracked) so the catalog syncs across
# machines. It is still seeded from the embedded default on a fresh checkout.
# Runtime build-duration stats (used for the build ETA).
/config/build-stats.json
# Generated reverse-proxy config.
/config/Caddyfile
# Harness settings + secrets (gateway key, terminal key); written 0600.
/config/harness.json
# The factory's access token (every /api call needs it); written 0600 via a
# temp file that a crash mid-write could leave behind.
/config/factory-token
/config/.factory-token-*

# The harness workspace terminal's shared folder (the model's files).
/workspace/*
!/workspace/.gitkeep

# Agent scratch/temp files.
/scratchpad/

# stray build artifacts
/ensemblegate
/builder
/llmgate
