# syntax=docker/dockerfile:1
#
# CPU image: compiles llama.cpp with architecture-appropriate SIMD, bakes a
# single GGUF (provided in the build context as `model.gguf`) into the image,
# and fronts it with the `llmgate` shim that injects the baked initialization
# prompt and, when the image bakes one, runs the agent harness (tool loop). The
# Go builder stages model.gguf, system_prompt.txt, gate/ (llmgate + the
# internal/gate and internal/agent packages) and harness/ (harness.json +
# skills, placeholders without a harness) into a tiny temp build context.
#
# Architecture-aware (via BuildKit's automatic TARGETARCH):
#   amd64  -> portable x86-64 AVX2/FMA/F16C  (Intel/AMD, incl. Intel Macs)
#   arm64  -> ARMv8.2 NEON + dotprod + fp16  (Apple Silicon M1+, ARM servers)
# The image is built for the host's architecture by default, so on an Apple
# Silicon Mac this produces a native arm64 image (NOT x86 under emulation).

# ----------------------------------------------------------------------------
# Stage 1: compile llama-server (static; no shared-lib sprawl in runtime)
# ----------------------------------------------------------------------------
FROM debian:bookworm-slim AS builder
# Pinned llama.cpp release for reproducible builds (override to track master).
ARG LLAMA_CPP_REF=v0.9.0
# TARGETARCH is auto-populated by BuildKit (Docker Desktop's default builder).
# If BuildKit is disabled (older Linux Docker), it is empty and we fall back to
# the amd64 SIMD path — identical to the previous x86-only behaviour.
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp.git
WORKDIR /src/llama.cpp
# Build llama-server with no embedded WebUI; we only use its OpenAI API.
# LLAMA_BUILD_UI=OFF just skips the npm build: llama.cpp still downloads a
# prebuilt UI from a Hugging Face bucket unless LLAMA_USE_PREBUILT_UI=OFF. A
# --depth 1 clone reports build number 1, so that download asks for a
# nonexistent "b1" bundle and falls back to "latest", which can drift out of
# step with the pinned source (missing loading.html) and abort the build.
# With both off, llama.cpp embeds an empty asset table and the build is offline.
#
# Pick SIMD flags by target arch. arm64 uses an ARMv8.2 baseline (dotprod+fp16)
# that every Apple Silicon chip (M1 and up) supports, so the image stays
# portable across M-series Macs while still getting the NEON dot-product kernels
# that matter most for llama.cpp throughput.
#
# Parallel compile jobs: BUILD_JOBS=0 (the default) sizes them to the build
# machine, min(CPUs, available RAM / 1.5 GiB) and at least 1. A plain
# `-j $(nproc)` starts one compiler per CPU whatever the RAM, and on a VM with
# many CPUs but little memory the kernel OOM-kills them ("Killed signal
# terminated program cc1plus"). --build-arg BUILD_JOBS=N forces N jobs.
ARG BUILD_JOBS=0
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      arm64) ARCH_FLAGS="-DCMAKE_C_FLAGS=-march=armv8.2-a+dotprod+fp16 -DCMAKE_CXX_FLAGS=-march=armv8.2-a+dotprod+fp16" ;; \
      *)     ARCH_FLAGS="-DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON" ;; \
    esac; \
    MEM_KB="$(sed -n 's/^MemAvailable:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)"; \
    JOBS=$(( ${MEM_KB:-0} / 1572864 )); \
    [ "$JOBS" -le "$(nproc)" ] || JOBS="$(nproc)"; \
    case "${BUILD_JOBS:-0}" in *[!0-9]*) ;; *) [ "${BUILD_JOBS:-0}" -eq 0 ] || JOBS="$BUILD_JOBS" ;; esac; \
    [ "$JOBS" -ge 1 ] || JOBS=1; \
    echo "Compiling with $JOBS parallel job(s): $(nproc) CPUs, $(( ${MEM_KB:-0} / 1024 )) MiB RAM available"; \
    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DLLAMA_CURL=OFF \
        -DLLAMA_BUILD_UI=OFF -DLLAMA_USE_PREBUILT_UI=OFF \
        -DGGML_NATIVE=OFF \
        ${ARCH_FLAGS} \
    && cmake --build build --config Release -j "$JOBS" --target llama-server

# ----------------------------------------------------------------------------
# Stage 2: compile the llmgate entrypoint shim (static, stdlib-only)
# ----------------------------------------------------------------------------
FROM golang:1.22-bookworm AS gate
WORKDIR /src
# gate/ mirrors the repo: go.mod, cmd/llmgate/, internal/gate/, internal/agent/
# (stdlib only).
COPY gate/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /llmgate ./cmd/llmgate

# ----------------------------------------------------------------------------
# Stage 3 (runtime-base): slim runtime, no model in it
# ----------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime-base
ARG INJECT_MODE=missing
ARG MODALITY=text
ARG CTX_SIZE=4096
# /workspace is where the harness's file and shell tools work; it belongs to the
# unprivileged llama user the container runs as. Mount a host folder there with
# -v to keep the files (see docs/HARNESS.md, "Baked harness").
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 llama \
    && mkdir -p /etc/llmgate /workspace \
    && chown llama /workspace

COPY --from=builder /src/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=gate    /llmgate                              /usr/local/bin/llmgate

# Tunables (override per `docker run -e ...`). THREADS defaults to the container's
# CPU count (set by llmgate); set it explicitly to cap or leave cores free.
# PORT is public (llmgate); UPSTREAM_PORT is llama-server, internal only.
ENV MODEL_PATH=/models/model.gguf \
    PORT=8080 \
    UPSTREAM_PORT=8081 \
    CTX_SIZE=${CTX_SIZE} \
    PARALLEL=1 \
    NGL=0 \
    MMPROJ_PATH=/models/mmproj.gguf \
    MODALITY=${MODALITY} \
    SYSTEM_PROMPT_FILE=/etc/llmgate/system_prompt.txt \
    INJECT_MODE=${INJECT_MODE} \
    HARNESS_FILE=/etc/llmgate/harness.json

EXPOSE 8080
USER llama

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=5 \
    CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

ENTRYPOINT ["/usr/local/bin/llmgate"]

# ----------------------------------------------------------------------------
# Stage 4: the model, baked in. Build with --target runtime-base for the same
# runtime without it: llmgate then reads MODEL_PATH from a mounted volume, and
# the system prompt, harness and mmproj are optional (a missing one is skipped).
# ----------------------------------------------------------------------------
FROM runtime-base AS runtime
COPY model.gguf         /models/model.gguf
# Always-present vision projector (empty placeholder for text; real for VLMs).
COPY mmproj.gguf        /models/mmproj.gguf
COPY system_prompt.txt  /etc/llmgate/system_prompt.txt
# Agent harness: harness.json (empty = no harness) and skills/, root-owned so
# the model can read but not change them.
COPY harness/           /etc/llmgate/
